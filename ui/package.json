{
  "name": "ghrm-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "trustedDependencies": [
    "esbuild",
    "rollup"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build && tsx scripts/check.ts pack",
    "build:runtime": "vite build",
    "build:check": "vite build --outDir .vite-check && tsx scripts/check.ts source",
    "build:watch": "vite build --watch",
    "icons:check": "tsx scripts/icons.ts check",
    "icons:write": "tsx scripts/icons.ts write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "happy-dom": "20.11.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tsx": "4.23.12",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vitest": "^3.2.6"
  }
}
